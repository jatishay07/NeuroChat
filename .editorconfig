# Editor settings that match the Google style guides used here (see docs/style.md).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 80

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{cmd,ps1}]
end_of_line = crlf
indent_size = 4

[{portal/vendor,portal/web}/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
