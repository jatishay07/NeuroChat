{
  "manifest_version": 3,
  "name": "NeuroChat",
  "version": "0.1.0",
  "description": "A side chat that explains what you're reading, using the NeuroChat tutor on your own computer.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open the NeuroChat side chat", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "contextMenus", "storage", "tabs", "scripting"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }, {
    "matches": ["<all_urls>"],
    "js": ["study/study-pace.js", "study/study-content.js"],
    "run_at": "document_idle"
  }],
  "commands": {
    "explain-selection": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Explain the selected text in the side chat"
    },
    "study-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Study mode on this page: light the paragraph you're reading and notice the slow ones"
    }
  }
}
